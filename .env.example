# Copia este archivo a .env. NUNCA subas .env al repositorio.
# Solo variables públicas del cliente (prefijo EXPO_PUBLIC_). No pongas claves secretas aquí.

# --- Supabase (etapa 10). Solo la clave anónima; la protección real es RLS en la base de datos.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Maps (etapa 8). Restringe la key por package/SHA-1 (Android) y bundle id (iOS).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
